# Base URL of the FastAPI backend.
#
# Defaults to the deployed Railway URL when this variable is unset, so the
# frontend works out of the box against production data. Override locally to
# point at `http://localhost:8000` while iterating on the API.
NEXT_PUBLIC_API_URL=https://quant-production-d645.up.railway.app

# Service token for driving the signed-in pages on a LOCAL dev server
# without a Google account. Must match the backend's SERVICE_TOKEN.
#
# Honoured only when NODE_ENV is not "production", so a production build
# strips the branch and never carries the value. Leave it unset unless you
# are testing.
NEXT_PUBLIC_DEV_API_TOKEN=
