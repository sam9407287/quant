# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
# Railway injects these automatically in production.
# For local development, use docker-compose defaults below.
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/quant_futures

# --- Data Fetcher ---
FETCH_INSTRUMENTS=NQ,ES,YM,RTY,GC,SI,HG,CL,NG
FETCH_OVERLAP_DAYS=7
# Cron: weekdays at 00:00 UTC (08:00 Taiwan time)
FETCH_CRON=0 0 * * 1-5

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated allowed origins for CORS (frontend URL in production)
CORS_ORIGINS=http://localhost:3000

# --- Security ---
# Generate with: openssl rand -hex 32
API_SECRET_KEY=changeme

# --- Period 3: IBKR (not needed until live trading) ---
# IBKR_HOST=
# IBKR_PORT=4003
# IBKR_CLIENT_ID=1

# Service token — automated end-to-end testing of the signed-in surface.
#
# Empty (the default) means the code path does not exist: Google is the only
# way in. Set it to a long random secret (openssl rand -hex 32) to let a test
# client authenticate as SERVICE_TOKEN_EMAIL. Deleting the variable revokes
# it; nothing else to undo. Shorter than 32 chars is refused outright.
#
# The account is an ordinary user, NOT an admin — a leaked secret buys a
# sandbox, not read/write over everyone's data. Put SERVICE_TOKEN_EMAIL in
# ADMIN_EMAILS only if you deliberately want more.
SERVICE_TOKEN=
SERVICE_TOKEN_EMAIL=service-bot@quant.local

# --- Statistical arbitrage lab (ADR-010) — fetcher service ---------------
# Discord webhook for pairs alerts. Keep it on a separate channel from
# NOTIFY_WEBHOOK_URL. Empty = the daily job runs but posts nothing.
PAIRS_WEBHOOK_URL=
# Dry run: scan, persist state and signals, post nothing. Leave on for the
# first two weeks after activation and compare decisions with the backtest.
PAIRS_DRY_RUN=false
# UTC cron for the daily job (after the US close; DST-proof as written).
PAIRS_CRON=0 23 * * 1-5
# Notional the entry alert sizes against (integer contracts, micro first).
PAIRS_CAPITAL=1000000
# One compact z digest per day; opt-in notice when no new bar arrived.
PAIRS_DAILY_DIGEST=true
PAIRS_NOTIFY_NO_DATA=false
# History requested for tickers seen for the first time.
PAIRS_HISTORY_YEARS=10
